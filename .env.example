# Local development only. Copy to .env (git-ignored) and change the passwords before first start.
# Placeholder values only; never put real secrets or real patient data here.

# Application name used in framework messages.
APP_NAME="Nile Clinic"
# Environment name; keep "local" for development.
APP_ENV=local
# Encryption key; leave empty here and run `php artisan key:generate` after copying.
APP_KEY=
# Detailed error output; true for local development only.
APP_DEBUG=true
# Base URL of the API; must match APP_PORT.
APP_URL=http://localhost:8080
# Host port for the nginx web service, bound to 127.0.0.1 only.
APP_PORT=8080

# Default response locale and fallback; supported locales are en and ar.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database driver; MySQL is the only supported connection.
DB_CONNECTION=mysql
# Compose service name of the database; do not use localhost.
DB_HOST=mysql
# MySQL port on the Compose network (not published to the host).
DB_PORT=3306
# Development database, created by the mysql service on first start.
DB_DATABASE=clinic
# Application database user, created by the mysql service on first start.
DB_USERNAME=clinic
# Application database password; change before use.
DB_PASSWORD=change-me
# Test database created by docker/mysql/init; must match DB_DATABASE in phpunit.xml.
DB_TEST_DATABASE=clinic_testing
# MySQL root password, used only inside the mysql container; change before use.
MYSQL_ROOT_PASSWORD=change-me-root

# Sessions are not used by the stateless API.
SESSION_DRIVER=array
# Cache and queue use database tables from the default migrations.
CACHE_STORE=database
QUEUE_CONNECTION=database
# Log channel and minimum level; logs are written under storage/logs.
LOG_CHANNEL=stack
LOG_LEVEL=debug
