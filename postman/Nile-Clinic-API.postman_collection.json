{
  "info": {
    "name": "Nile Clinic API",
    "description": "Backend API of the Nile Clinic Management System (Laravel 13, `/api/v1`).\n\nContracts: `specs/001-project-foundation/contracts/health.openapi.yaml` and\n`specs/002-staff-auth-roles/contracts/staff-auth.openapi.yaml`.\n\n**Run order**: System → Auth/sign in (stores `token`) → Auth → Staff → Auth/sign out.\nSelect the **Nile Clinic Local** environment and set `admin_email` / `admin_password` to an\nadministrator created with `php artisan staff:create-admin`. All data must be synthetic.\n\nEvery request sends `Accept: application/json` and `Accept-Language: {{locale}}` (`en` or `ar`);\nfield names and structure are identical in both locales, only `message` texts change.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "description": "Public health check (feature 001).",
      "item": [
        {
          "name": "health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the health contract body', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.eql({ status: 'ok', checks: { database: 'ok' } });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Reports whether the API can reach its database. Public, no input. 200 with \"ok\", or 503 with\n\"unavailable\" and no internal details."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept-Language",
                    "value": "{{locale}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/health",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "health"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"status\": \"ok\", \"checks\": {\"database\": \"ok\"}}"
            },
            {
              "name": "503 Service Unavailable",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept-Language",
                    "value": "{{locale}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/health",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "health"
                  ]
                }
              },
              "status": "Service Unavailable",
              "code": 503,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"status\": \"unavailable\", \"checks\": {\"database\": \"unavailable\"}}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Sign in, the signed-in member's own account, and sign out (feature 002, US1 and US5).\nTokens expire after 8 hours without a request. After 5 failed attempts for one email, or 20\nfrom one address, within a minute, sign-in is refused for up to a minute.",
      "item": [
        {
          "name": "sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with a Bearer token and the account', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.token_type).to.eql('Bearer');",
                  "  pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.user.role).to.eql('administrator');",
                  "  pm.expect(data.user).to.not.have.property('password');",
                  "  pm.collectionVariables.set('token', data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/sign-in",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "sign-in"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Sign in with email and password. Stores the returned token in the collection variable `token`,\nwhich every other request sends as `Authorization: Bearer {{token}}`. Unknown email, wrong\npassword, and deactivated account all get the same 422 message. Emails are printable ASCII;\ncase and surrounding spaces are ignored."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept-Language",
                    "value": "{{locale}}"
                  },
