    {
      "name": "Staff",
      "description": "Staff account management, administrators only (feature 002, US3). Receptionists and doctors\nget 403. Ids are numeric; unknown ids get 404.",
      "item": [
        {
          "name": "list staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 paginated, no passwords', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.keys('data', 'links', 'meta');",
                  "  pm.expect(pm.response.text()).to.not.include('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/staff?per_page=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "staff"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "receptionist",
                  "description": "administrator, receptionist, or doctor",
                  "disabled": true
                },
                {
                  "key": "is_active",
                  "value": "true",
                  "description": "true/false or 1/0",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "1–100, default 15"
                }
              ]
            },
            "description": "One page of staff accounts ordered by name, then id. Laravel's paginated shape: data, links, meta."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
