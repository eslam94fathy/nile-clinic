                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "sign-in"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"data\": {\"token\": \"1|<plain-text token, shown once>\", \"token_type\": \"Bearer\", \"user\": {\"id\": 1, \"name\": \"Test Admin\", \"email\": \"admin@clinic.test\", \"role\": \"administrator\", \"is_active\": true, \"created_at\": \"2026-10-27T16:26:43+00:00\", \"updated_at\": \"2026-10-27T16:26:43+00:00\"}}}"
            },
